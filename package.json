{
  "name": "zee",
  "version": "1.0.0",
  "description": "Zee Design Studio Website",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/build-site.mjs",
    "predev": "node scripts/build-site.mjs",
    "start": "npx serve . -p 3000 --cors",
    "dev": "npx serve . -p 3000 --cors",
    "build": "node scripts/build-site.mjs",
    "build:check": "node scripts/build-site.mjs --check",
    "test": "playwright test",
    "images:optimize": "node scripts/optimize-images.mjs",
    "version:update": "node update-version.js",
    "version:timestamp": "node update-version.js $(date +%s)"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "lenis": "^1.3.26",
    "serve": "^14.2.6",
    "sharp": "^0.34.5"
  }
}
